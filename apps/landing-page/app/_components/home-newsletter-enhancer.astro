<script is:inline>
  (() => {
    for (const form of document.querySelectorAll('form[data-newsletter]')) {
      if (!(form instanceof HTMLFormElement)) continue;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const input = form.querySelector('input[type="email"], input[name="email"]');
        if (!(input instanceof HTMLInputElement)) return;

        const email = input.value.trim();
        if (!email) return;

        const submit = form.querySelector('[type="submit"]');
        form.querySelector('.newsletter-error')?.remove();
        if (submit instanceof HTMLButtonElement) submit.disabled = true;

        const showDone = () => {
          const done = document.createElement('p');
          done.className = 'newsletter-done';
          done.textContent = form.dataset.newsletterDone || 'Thanks!';
          form.replaceChildren(done);
        };

        const showError = () => {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
          if (form.querySelector('.newsletter-error')) return;
          const error = document.createElement('p');
          error.className = 'newsletter-error';
          error.setAttribute('role', 'alert');
          error.textContent = form.dataset.newsletterError || "Couldn't subscribe just now — please try again.";
          form.appendChild(error);
        };

        fetch('/subscribe', {
          body: JSON.stringify({ email, source: 'landing' }),
          headers: { 'Content-Type': 'application/json' },
          method: 'POST',
        })
          .then((response) => {
            if (response.ok) showDone();
            else showError();
          })
          .catch(showError);
      });
    }
  })();
</script>
